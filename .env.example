# Copy this file to .env and adjust the values.

# Your site's public address. The site uses it to build full links:
# sitemap.xml, robots.txt, link-preview images, share/copy buttons and
# canonical URLs for search engines.
#   - Locally (.env):              http://localhost:3000
#   - On Vercel (dashboard → Settings → Environment Variables, Production):
#                                  https://your-real-domain.com
# If it's missing in production, the site falls back to
# FALLBACK_SITE_ORIGIN in constants/site.ts.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shows the internal /docs-admin handbook and its navbar link (lib/flags.ts).
# Only "development" turns it on. Never set this on Vercel.
environment=development
NODE_ENV=development