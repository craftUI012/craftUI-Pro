# Copy this file to .env and adjust the values.

# Your site's public address. The site uses it to build full links:
# sitemap.xml, robots.txt, link-preview images, share/copy buttons and
# canonical URLs for search engines.
#   - Locally (.env):              http://localhost:3000
#   - On Vercel (dashboard → Settings → Environment Variables, Production):
#                                  https://your-real-domain.com
# If it's missing in production, the site falls back to
# FALLBACK_SITE_ORIGIN in constants/site.ts.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shows the internal /docs-admin handbook and its navbar link (lib/flags.ts).
# Only "development" turns it on. Never set this on Vercel.
environment=development
NODE_ENV=development

# Cloudflare R2
CLOUDFLARE_ACCOUNT_ID=YOUR_CLOUDFLARE_ACCOUNT_ID
R2_ACCESS_KEY_ID=YOUR_R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=YOUR_R2_SECRET_ACCESS_KEY
R2_BUCKET=YOUR_R2_BUCKET
R2_PUBLIC_BASE_URL=YOUR_R2_PUBLIC_BASE_URL
# Folder in the bucket holding the browse-card screenshots (content/media-manifest.json)
R2_IMAGES_FOLDER=Images_product_cards
# Folder in the bucket holding the browse-card videos (content/video-manifest.json)
R2_VIDEOS_FOLDER=Videos_product_cards
# Production address `pnpm media prune` checks before deleting old files
MEDIA_LIVE_URL=YOUR_PRODUCTION_URL

# Analytics (PostHog) - optional, but recommended for product analytics and session replay.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=YOUR_POSTHOG_PROJECT_TOKEN
NEXT_PUBLIC_POSTHOG_HOST=YOUR_POSTHOG_HOST

MONGODB_URI=mongodb+srv://<>:<>@cluster0.velq37g.mongodb.net/craftui?retryWrites=true&w=majority&appName=YOUR_APP_NAME

# --- Auth (Better Auth magic link + MongoDB + Reloop) ---
# MongoDB connection string, with the database name after the host (/craftui).
# Atlas: Connect -> Drivers. Network Access must allow Vercel (0.0.0.0/0, or
# the Vercel <-> Atlas integration, which also sets this variable).
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/craftui?retryWrites=true&w=majority&appName=craftui
# Random secret, at least 32 chars. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
# Must match the app origin. Locally http://localhost:3000, in prod your domain.
BETTER_AUTH_URL=http://localhost:3000
# Reloop transactional email.
RELOOP_API_KEY=rl_...
# Who can open the admin panel (/admin-panel-craft), comma-separated. They can
# also sign in without a purchase. Empty means nobody.
ADMIN_EMAILS=you@example.com

# --- Billing (Dodo Payments) ---
# Prices shown on the site, in whole US dollars (decimals allowed: 129.99).
# Display only: Dodo charges its product's own price, so change the product
# in Dodo to the same amount. Restart pnpm dev (or redeploy) after changing.
NEXT_PUBLIC_LIFETIME_PRICE_USD=249
NEXT_PUBLIC_YEARLY_PRICE_USD=129
# test_mode while testing, live_mode to charge real cards (anything else is
# test mode). The key, webhook secret and product IDs below must all come
# from that same mode in the Dodo dashboard.
DODO_PAYMENTS_ENVIRONMENT=test_mode
# Developer → API Keys.
DODO_PAYMENTS_API_KEY=YOUR_DODO_PAYMENTS_API_KEY
# Developer → Webhooks: add <site>/api/webhooks/dodo, then copy its secret
# (starts with whsec_).
DODO_PAYMENTS_WEBHOOK_KEY=YOUR_DODO_PAYMENTS_WEBHOOK_KEY
# Products: Lifetime as a one-time payment, Yearly as a yearly subscription.
# Paste each product's ID (pdt_…).
DODO_LIFETIME_PRODUCT_ID=
DODO_YEARLY_PRODUCT_ID=

# --- PostHog (product analytics, session replay) ---
# Project settings → Project token (public by design: send-only). Set both on
# Vercel too. Leave the token empty to turn PostHog off.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_...
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

