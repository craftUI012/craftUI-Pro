# SEO Engine — variables read by seo-engine/pipeline and the admin dashboard.
# Local: add these to the repo root .env (which is gitignored).
# Pipeline in GitHub Actions: repository secrets/variables (02-service-setup.md §8).
# Dashboard on Vercel: only the variables marked [vercel].

# --- Site -------------------------------------------------------------------
# Already in the root .env.example; the engine reads the same value.
NEXT_PUBLIC_SITE_URL=https://www.craftui.space

# --- MongoDB (shared with the site; also a GitHub secret) [vercel] -----------
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/craftui?retryWrites=true&w=majority&appName=craftui

# --- Google Search Console --------------------------------------------------
# Local: path to the service account JSON. Actions/Vercel: GOOGLE_SERVICE_ACCOUNT_JSON holds the JSON text instead.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/seo-engine-gsc.json
# GOOGLE_SERVICE_ACCOUNT_JSON=                      # [vercel] full JSON text
# Domain property, confirmed 2026-11-03.
GSC_PROPERTY=sc-domain:craftui.space               # [vercel]

# --- PostHog (US cloud) -----------------------------------------------------
POSTHOG_HOST=https://us.posthog.com
POSTHOG_PROJECT_ID=12345
POSTHOG_API_KEY=phx_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- DataForSEO -------------------------------------------------------------
DATAFORSEO_LOGIN=you@example.com
DATAFORSEO_PASSWORD=xxxxxxxxxxxxxxxx
# Sandbox until the first dry run is reviewed; then https://api.dataforseo.com/v3
DATAFORSEO_BASE_URL=https://sandbox.dataforseo.com/v3
# 2840 = United States, 2826 = United Kingdom, 2356 = India
DATAFORSEO_LOCATION_CODE=2840
DATAFORSEO_LANGUAGE_CODE=en

# --- Anthropic --------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SEO_MODEL_FAST=claude-haiku-5-5
SEO_MODEL_PLAN=claude-sonnet-5-5

# --- IndexNow [vercel] ------------------------------------------------------
# The key file public/<key>.txt lives in this repo.
INDEXNOW_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Dashboard "Run now" button [vercel] ------------------------------------
# Fine-grained PAT, this repo only, Actions: read and write.
SEO_GITHUB_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SEO_GITHUB_REPO=craftUI012/craftUI-Pro

# --- Run controls -----------------------------------------------------------
# 1 = skip Claude (except the check) and use the DataForSEO sandbox
SEO_DRY_RUN=1
# Caps; config/engine.json holds defaults, these override per run
SEO_MAX_PLANS_PER_RUN=10
SEO_MAX_SERP_LOOKUPS_PER_RUN=400
SEO_MAX_TOKENS_PER_RUN=1000000
